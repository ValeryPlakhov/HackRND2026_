{
  "schema": "blueprints.visual/1",
  "title": "Стоимость покупок",
  "steps": [
    {
      "id": "basket_prices",
      "type": "input",
      "config": {
        "name": "Цены через пробел",
        "dataType": "list",
        "example": "100 250 300"
      }
    },
    {
      "id": "basket_total",
      "type": "value",
      "config": {
        "name": "Итого",
        "value": {
          "kind": "literal",
          "type": "number",
          "value": 0
        }
      }
    },
    {
      "id": "basket_loop",
      "type": "foreach",
      "config": {
        "list": {
          "kind": "ref",
          "id": "basket_prices"
        },
        "itemName": "Текущая цена"
      },
      "body": [
        {
          "id": "basket_add",
          "type": "change",
          "config": {
            "target": "basket_total",
            "operator": "+",
            "value": {
              "kind": "ref",
              "id": "basket_loop_item"
            }
          }
        }
      ]
    },
    {
      "id": "basket_answer",
      "type": "print",
      "config": {
        "text": "Итого к оплате: ",
        "value": {
          "kind": "ref",
          "id": "basket_total"
        }
      }
    }
  ],
  "inputs": {
    "basket_prices": "100 250 300"
  }
}