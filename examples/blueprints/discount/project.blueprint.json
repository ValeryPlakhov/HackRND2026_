{
  "schema": "blueprints.visual/1",
  "title": "Скидка в магазине",
  "steps": [
    {
      "id": "shop_amount",
      "type": "input",
      "config": {
        "name": "Сумма покупки, ₽",
        "dataType": "number",
        "example": "1500"
      }
    },
    {
      "id": "shop_rule",
      "type": "condition",
      "config": {
        "left": {
          "kind": "ref",
          "id": "shop_amount"
        },
        "operator": ">=",
        "right": {
          "kind": "literal",
          "type": "number",
          "value": 1000
        }
      },
      "yes": [
        {
          "id": "shop_yes",
          "type": "print",
          "config": {
            "text": "Вам доступна скидка 10%!",
            "value": null
          }
        }
      ],
      "no": [
        {
          "id": "shop_no",
          "type": "print",
          "config": {
            "text": "Для этой суммы скидка пока недоступна.",
            "value": null
          }
        }
      ]
    }
  ],
  "inputs": {
    "shop_amount": "1500"
  }
}